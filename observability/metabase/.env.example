# Metabase Configuration
# Copy this file to .env and fill in your values

# Required: Database password for Metabase's internal PostgreSQL
MB_DB_PASSWORD=your-db-password-here

# Required: Domain where Metabase will be accessible (without https://)
METABASE_DOMAIN=analytics.yourdomain.com

# Optional: Site name displayed in Metabase UI
MB_SITE_NAME=Analytics
