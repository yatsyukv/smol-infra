# GlitchTip Configuration
# Copy this file to .env and fill in your values

# Required: Secret key for Django (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here

# Required: Database password for PostgreSQL
DB_PASSWORD=your-db-password-here

# Required: Domain where GlitchTip will be accessible (without https://)
GLITCHTIP_DOMAIN=errors.yourdomain.com

# Optional: Email configuration for notifications
# Format: smtp://user:password@host:port
# Examples:
#   smtp://user:pass@smtp.gmail.com:587
#   smtp+tls://user:pass@smtp.example.com:465
#   console:// (for local testing, prints to console)
EMAIL_URL=console://

# Optional: Default sender email address
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
